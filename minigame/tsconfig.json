{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../frontend/src/*"]
    }
  },
  "include": ["src", "../frontend/src/autochess/types.ts"]
}
